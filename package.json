{
    "name": "mirror-server",
    "version": "2.0.0",
    "description": "API server for nekoha mirror",
    "main": "dist/Index.js",
    "scripts": {
        "build": "tsc",
        "start": "NODE_ENV=production TS_NODE_BASEURL=./dist node -r tsconfig-paths/register dist/Index.js",
        "dev": "NODE_ENV=development ts-node -r tsconfig-paths/register src/Index.ts",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "doc": "npx apidoc-markdown -i src/ -o README.MD"
    },
    "dependencies": {
        "archiver": "^8.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.21.2",
        "ioredis": "^5.8.2",
        "pg": "^8.11.3",
        "tsconfig-paths": "^4.2.0",
        "yauzl": "^3.3.0"
    },
    "devDependencies": {
        "@types/archiver": "^8.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/node": "^22.19.0",
        "@types/pg": "^8.15.6",
        "@types/yauzl": "^3.4.0",
        "apidoc": "^1.2.0",
        "apidoc-markdown": "^7.3.2",
        "rimraf": "^6.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
